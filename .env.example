# Monorepo Environment Configuration
# ====================================
# This is the SINGLE SOURCE OF TRUTH for shared environment variables.
# Docker Compose and all apps read from this file automatically.
#
# Setup Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Run: supabase start
# 3. Get credentials: supabase status -o env
# 4. Fill in the <YOUR_*> placeholders below
#
# App-Specific Variables:
# - apps/api/.env - OpenAPI config, Sentry DSN
# - apps/nuxt/.env - Nuxt secrets
# - apps/nitro/.env - Port overrides

# Environment
NODE_ENV=development

# PostgreSQL Configuration (for docker-compose.db.yml)
# These vars configure the PostgreSQL container itself
# Note: If using Supabase (recommended), you don't need to change these
POSTGRES_PORT=54322
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Database Connection String (used by application code)
# Local dev: localhost | Docker accessing host: host.docker.internal | Production: hosted DB URL
# Get password from: supabase status | grep "DB password"
DATABASE_URL=postgresql://postgres:<YOUR_SUPABASE_PASSWORD>@localhost:54322/postgres

# Supabase Configuration
# Supabase runs from root ./supabase directory
# Start with: supabase start
# Get credentials from: supabase status -o env
SUPABASE_URL=http://localhost:54321

# Option 1: New key system (2025+) - Recommended for new projects
# Get from: supabase status | grep "publishable key"
# Get from: supabase status | grep "secret key"
SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
SUPABASE_SECRET_KEY=<YOUR_SUPABASE_SECRET_KEY>

# Option 2: Legacy JWT keys - Fallback for backward compatibility
# Get from: supabase status -o env | grep "ANON_KEY"
# Get from: supabase status -o env | grep "JWT_SECRET"
# Only fill these if not using new key system above
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_AUTH_JWT_SECRET=<YOUR_SUPABASE_JWT_SECRET>

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Application Ports
VITE_PORT=3000
NUXT_PORT=3001
API_PORT=3002
NITRO_PORT=3004
DOCS_PORT=3003
STORYBOOK_PORT=6006


# API Base URL (for Nuxt frontend)
NUXT_PUBLIC_API_BASE=http://localhost:3002

# Logging
LOG_LEVEL=info
