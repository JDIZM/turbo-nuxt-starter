auto-install-peers=true

# Supply-chain hardening (complements pnpm-workspace.yaml).
# Recompute tarball integrity on every install.
verify-store-integrity=true

# Fail install if package.json and the lockfile disagree — forces an
# intentional `pnpm install` locally rather than silent lockfile drift.
prefer-frozen-lockfile=true

# onlyBuiltDependencies (in pnpm-workspace.yaml) is the primary install-script
# gate. Left at false so that allowlist stays the single source of truth.
ignore-scripts=false
