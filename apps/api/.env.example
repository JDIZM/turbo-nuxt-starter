# API-Specific Configuration
# =========================
# Shared variables (DATABASE_URL, SUPABASE_*, CORS_ORIGIN, LOG_LEVEL, etc.)
# are inherited from the root .env file.
# Only add API-specific variables here.

# OpenAPI Documentation
# ---------------------
OPENAPI_TITLE=Turbo Nuxt Starter API
OPENAPI_VERSION=1.0.0
OPENAPI_DESCRIPTION=Production-ready REST API with Supabase authentication

# Error Tracking (Optional)
# -------------------------
# Uncomment and configure if using Sentry for error tracking
# SENTRY_DSN=<YOUR_SENTRY_DSN>
