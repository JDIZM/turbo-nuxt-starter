# Nuxt-Specific Configuration
# ============================
# Shared variables are inherited from the root .env file.
# Only Nuxt-specific variables are defined here.

# Public base URL for API calls (exposed to client)
NUXT_PUBLIC_API_BASE=http://localhost:3002

# Secret key for server-side API calls (never exposed to client)
# Generate with: openssl rand -base64 32
NUXT_API_SECRET=<GENERATE_WITH_OPENSSL_RAND>
